{
  "name": "maisondebrah-ethiopia-staging",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run validate:content",
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run validate:content && tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "npm run validate:content && tsc -b && vite build --base /maison-debrah-et-last-edition/"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
